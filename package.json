{
  "name": "azvault",
  "private": false,
  "version": "1.0.1",
  "description": "Azure Key Vault Explorer - Desktop App",
  "author": {
    "name": "Taras Kovalenko",
    "email": "bad.kto@gmail.com"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint . --max-diagnostics=200",
    "lint:fix": "biome check . --write --unsafe --max-diagnostics=200",
    "format": "biome format --write .",
    "test:react": "vitest run --coverage",
    "preview": "vite preview",
    "tauri": "cargo tauri",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "tsc -b && vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-store": "^2.4.2",
    "date-fns": "^4.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
