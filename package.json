{
  "name": "azvault",
  "private": false,
  "version": "1.1.2",
  "description": "Azure Key Vault Explorer - Desktop App",
  "author": {
    "name": "Taras Kovalenko",
    "email": "bad.kto@gmail.com"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint . --max-diagnostics=200",
    "lint:fix": "biome check . --write --unsafe --max-diagnostics=200",
    "format": "biome format --write .",
    "test:react": "vitest run --coverage",
    "preview": "vite preview",
    "tauri": "cargo tauri",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "tsc -b && vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-store": "^2.5.1",
    "date-fns": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
